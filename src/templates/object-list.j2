{% from '_variables.j2' import get_excluded_object_tags %}

{% extends "parents/base.j2" %}
{% block content %}

    <link rel="stylesheet" href="{{context._root_path}}/static/css/datatables/dataTables.dataTables_2_3_2.css" />
    <script src="{{context._root_path}}/static/js/jquery/jquery-3.7.1.slim.min.js"></script>
    <script src="{{context._root_path}}/static/js/datatables/dataTables.js"></script>

    <h1 data-i18n="biographies.title" class="h3 fw-light">Biographien der Grazer NS-Opfer</h1>
    <p data-i18n="biographies.subtitle">Personen erfassst im {{context.project.projectAbbr | upper}} Projekt. Wohnhafte oder ansässige Personen in Graz ermordert durch das NS-Regime.</p>

    {# <pre>{{ context | tojson(indent=2) }}</pre> #}
    <table id="example" class="display">
        <thead>
            <tr>
                {# <th>#</th> #}
                <th data-i18n="object-list.forename">Vorname</th>
                <th data-i18n="object-list.surname">Nachname</th>
                <th data-i18n="object-list.description" class="d-none d-sm-block">Beschreibung</th>
                <th data-i18n="object-list.category">Opferkategorie</th>
            </tr>
        </thead>
        <tbody>
            {% for object in context.objects|sort(attribute='baseMetadata.title') %}
                {# show only objects of tag person #}
                {% if 'person' in object.tags %}
                    <tr>
                        {# <td>
                            <img loading="lazy" src="{{context.env.IIIF_IMAGE_SERVER_ORIGIN}}/iiif/2/{{context.project.projectAbbr}}%2f{{object.id}}%2f1.jpg/full/,100/0/default.jpg" alt="Person 369">
                        </td> #}
                        {% set clean_title = object.baseMetadata.title | replace("(person description)", "") | trim %}
                        {% set name_parts = clean_title.rsplit(' ', 1) %}
                        <td>
                            {{ name_parts[0] if name_parts|length > 1 else '' }}
                        </td>
                        <td>
                            <a href="{{context._root_path}}/objects/{{object.id}}/">{{ name_parts[-1] }}</a>    
                        </td>
                        <td class="d-none d-sm-block"><small>{{ object.baseMetadata.description }}</small></td>
                        <td>
                            {% for tag in object.tags | reject('in', get_excluded_object_tags()) %}
                                {# <li><a data-i18n="{{tag}}" target="_blank" href="{{context.env.GAMS_API_ORIGIN}}/api/curation/v1/projects/{{context.project.projectAbbr}}/objects?tags={{tag}}">{{ tag }}</a></li> #}
                                <li><a data-i18n="{{tag}}" target="_blank">{{ tag }}</a></li>
                            {% endfor %}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
    <script>
        let dataTableContainer = document.getElementById('example');
        let dataTable = new DataTable('#example', {
            order: [[1,'asc']],
            language: {
                search: "Volltextsuche",
                lengthMenu: "Zeige _MENU_ Einträge",
                info: "Zeige _START_ bis _END_ von _TOTAL_ Einträgen",
                infoEmpty: "Keine Einträge vorhanden",
                infoFiltered: "(gefiltert von _MAX_ Einträgen)",
                zeroRecords: "Keine passenden Einträge gefunden"
            },
            drawCallback: function(settings) {
                // This replaces the non-standard onPageChange to ensure 
                // translation runs on every redraw (pagination, search, sort)
                gams_frog.i18n.translate(dataTableContainer);
            },
            initComplete: function () {
                let api = this.api();
                let column = api.column(3); // Index 3 is the "Opferkategorie" column

                console.log(column);


                // 1. Create the select element
                let select = document.createElement('select');
                select.className = 'dt-input'; // Matches some of DataTables default styling
                select.style.marginRight = '10px';
                let allOption = new Option('Alle Opferkategorien', '')
                allOption.setAttribute('data-i18n', 'victims.all');
                select.add(allOption);

                // 2. Insert the select element next to the search box
                let searchContainer = document.querySelector('.dt-search');
                if (searchContainer) {
                    searchContainer.prepend(select);
                }

                // 3. Apply the filter on change
                select.addEventListener('change', function () {
                    // Use exact match regex for tags to avoid matching substrings
                    let val = this.value ? `(?=.*\\b${DataTable.util.escapeRegex(this.value)}\\b)` : '';
                    
                    column
                        .search(val, true, false)
                        .draw();
                });

                // 4. Extract unique tags from the column data
                let uniqueTags = new Set();
                column.data().unique().each(function (cellHtml, j) {
                    // Parse the HTML content of the cell to get just the text of the tags
                    let tempDiv = document.createElement('div');
                    tempDiv.innerHTML = cellHtml;
                    let links = tempDiv.querySelectorAll('li a');
                    links.forEach(link => {
                        let tagValue = link.getAttribute('data-i18n');
                        if (tagValue) uniqueTags.add(tagValue);
                    });
                });

                // 5. Populate the dropdown with sorted tags
                Array.from(uniqueTags).sort().forEach(function (tag) {
                    let option = new Option(tag, tag);
                    option.setAttribute('data-i18n', tag);
                    select.add(option);
                });

                // run translation last?
                gams_frog.i18n.translate(dataTableContainer);
            }
        });

    </script>



   

{% endblock %}