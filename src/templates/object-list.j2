{% extends "parents/base.j2" %}
{% block content %}

    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.css" />
    <script
        src="https://code.jquery.com/jquery-3.7.1.slim.min.js"
        integrity="sha256-kmHvs0B+OpCW5GVHUNjv9rOmY0IvSIRcf7zGUDTDQM8="
        crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>

    <h1 class="h3 fw-light mt-5">Biographien der Grazer NS-Opfer</h1>
    <p>Personen erfassst im MEMO Projekt. Wohnhafte oder ansässige Personen in Graz ermordert durch das NS-Regime.</p>

    {# Collect unique Opferkategorien #}
    {% set categories = [] %}
    {% for object in context.objects %}
        {% if 'person' in object.tags %}
            {% for tag in object.tags | reject('in', ['person', 'male', 'female', 'jugendlich']) %}
                {% if tag not in categories %}
                    {% set _ = categories.append(tag) %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}
    {% set categories = categories | sort %}

    <div class="row mb-4">
        <div class="col-md-4 col-lg-3 mt-3 mb-2 p-2 bg-light border rounded" style="max-width: 320px;">
            <label for="categoryFilter" class="form-label">Nach Opferkategorie filtern:</label>
            <select id="categoryFilter" class="form-select form-select-sm">
                <option value="">alle</option>
                {% for cat in categories %}
                    <option value="{{ cat }}">{{ cat }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    {# <pre>{{ context | tojson(indent=2) }}</pre> #}
    <table id="example" class="display mt-2">
        <thead>
            <tr>
                <th></th>
                <th>Nachname</th>
                <th>Vorname</th>
                <th>Geburtsdatum</th>
                <th>Beschreibung</th> 
                <th>Opferkategorie</th>
            </tr>
        </thead>
        <tbody>
            {% for object in context.objects|sort(attribute='baseMetadata.title') %}
                {# show only objects of tag person #}
                {% if 'person' in object.tags %}
                    <tr>
                        <td>
                            <img loading="lazy" src="{{context.env.IIIF_IMAGE_SERVER_ORIGIN}}/iiif/2/{{context.project.projectAbbr}}%2f{{object.id}}%2f1.jpg/full/,100/0/default.jpg" alt="Person">
                        </td>
                        <td>
                            <a href="{{context._root_path}}/objects/{{object.id}}/">{{ object.baseMetadata.title.split(' ', 1)[-1] }}</a>
                        </td>
                        <td>
                        {{ object.baseMetadata.title.split(' ')[0] }}
                        </td>
                        <td>
                        {% if object.dublinCore.date|default([ ], true)|length > 0 %}
                            {{ object.dublinCore.date[0].value}}
                        {% endif %}
                        </td>
                        <td>
                            {{ object.baseMetadata.description[0:70] }}...<a href="{{context._root_path}}/objects/{{object.id}}/" style="color:gray">mehr</a>
                        </td>
                        <td>{{ object.tags | reject('in', ['person', 'male', 'female', 'jugendlich']) | join(', ') }}</td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
    <script>
        let dataTable = new DataTable('#example', {
            columnDefs: [
                { orderable: false, targets: [0, 3, 4, 5] }, 
            ],
            language: {
                search: "Suchen",
                lengthMenu: "Zeige _MENU_ Einträge",
                info: "Zeige _START_ bis _END_ von _TOTAL_ Einträgen",
                infoEmpty: "Keine Einträge vorhanden",
                infoFiltered: "(gefiltert von _MAX_ Einträgen)",
                zeroRecords: "Keine passenden Einträge gefunden"
            }
        });

        // Filter for Opferkategorie (narrow exact match)
        $('#categoryFilter').on('change', function() {
            const value = this.value;
            if (!value) {
                dataTable.column(5).search('').draw();
                return;
            }
            const regex = `(^|[,\s])+${value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(,|$)`;
            dataTable.column(5).search(regex, true, false).draw();
        });

    </script>



   

{% endblock %}