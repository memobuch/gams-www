{% extends "parents/base.j2" %}
{% block content %}
    <h1 class="h3 fw-light">Personenübersicht</h1>
    <p>Personen erfassst im MEMO Projekt. Wohnhafte oder ansässige Personen in Graz ermordert durch das NS-Regime.</p>

    <ul class="list-group list-group-flush border">
        {% for object in objects|sort(attribute="db.baseMetadata.title") %}
            <li class="list-group-item p-3">
                <div>
                    <p><a href="{{ object.db.id }}">{{ object.db.baseMetadata.title }}</a></p>
                    <img 
                        onerror="this.src='https://gams.uni-graz.at/templates/img/gams_solo_weiss.png'" 
                        alt="Image missing"
                        class="d-block mb-5 border bg-dark rounded" 
                        style="max-width: 15%;" 
                        src="http://localhost:18080/iiif/2/memo%2f{{object.db.id}}%2f1.jpg/full/100,/0/default.jpg"/>
                    <p>{{ object.db.baseMetadata.description }}</p>
                    {# <p>Todesdatum: {{ object.dc.date[0][0:10]}}</p> #}
                </div>
            </li>
        {% endfor %}
    </ul>

{% endblock %}