                            document.getElementById("spinner02").style = "display: none";
                        });
                });
            </script> #}

            <br/>
            <br/>
            <br/>
            <br/>

            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tify@0.34.4/dist/tify.css">
             <div id="tify" style="height: 100vh"></div>

            <script type="module">
                import Tify from 'https://cdn.jsdelivr.net/npm/tify@0.34.5/dist/tify.js'

                (async () => {

                    // TODO add development / build mode conditional

                    // 01. Prefetch manifest from remote server
                    //let manifestUrl = 'https://manifests.sub.uni-goettingen.de/iiif/presentation/PPN623133725/manifest';
                    let manifestUrl = '/memo/static/iiif-manifest.json';

                    
                    let resp = await fetch(manifestUrl);
                    if (!resp.ok) {
                        console.error(`Failed to fetch manifest: ${resp.status} ${resp.statusText}`);
                        return;
                    }
                    let manifest = await resp.text();

                    manifest = manifest.replaceAll("https://gams.uni-graz.at/iiif", "http://localhost:18080/iiif")

                    console.log(manifest);

                    // 02, Modify manifest to use local IIIF Image API endpoints
                    //let manifestAsString = JSON.stringify(manifest, null, 2);

                    // 03. Create a Blob URL for the modified manifest
                    let manifestBlobUrl = URL.createObjectURL(
                        new Blob([manifest], { type: 'application/json' })
                    );
                    
                    // 04. Initialize Tify with the manifest Blob URL
                    new Tify({
                        container: '#tify',
                        manifestUrl: manifestBlobUrl,
                    })


                })();

                
            </script>
        </div>
    </div>

</div>