{# <p>Some text</p> #}
{{ object.component_map.imprint }}

<style>
  /* Base styling for all memo components */
  memo-tei {
    display: block;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
  }
  
  /* Hide header elements as they contain metadata */
  memo-teiheader {
    display: none;
  }
  
  /* Main text container */
  memo-text {
    display: block;
  }
  
  memo-body {
    display: block;
  }
  
  /* Section styling */
  memo-div {
    display: block;
    margin-bottom: 2rem;
  }
  
  /* Heading styles */
  memo-head {
    display: block;
    font-weight: bold;
    margin-bottom: 1rem;
  }
  
  memo-div > memo-head {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding-bottom: 0.5rem;
  }
  
  memo-div > memo-div > memo-head {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }
  
  /* Paragraph styling */
  memo-p {
    display: block;
    margin-bottom: 1rem;
  }
  
  /* Line break handling */
  memo-lb {
    display: block;
  }
  
  /* Link styling to mimic <a> element */
  memo-ref {
    color: #0d6efd;
    text-decoration: underline;
    cursor: pointer;
  }
  
  memo-ref:hover {
    color: #0a58ca;
    text-decoration: underline;
  }
  
  /* Italic text */
  memo-hi[rend="italic"] {
    font-style: italic;
  }
  
  /* Person name styling */
  memo-persname {
    display: inline;
  }
  
  /* Organization name styling */
  memo-orgname {
    display: inline;
  }
  
  /* Language specific sections */
  memo-div[{http://www.w3.org/XML/1998/namespace}lang] {
    padding: 1.5rem;
    margin-bottom: 2rem;
    background-color: rgba(0, 0, 0, 0.03); /* Light background using Bootstrap's bg-light equivalent */
    border-radius: 0.25rem;
  }
  
  memo-div[{http://www.w3.org/XML/1998/namespace}lang] > memo-head {
    font-size: 1.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Make memo-ref elements behave like links
    const refElements = document.querySelectorAll('memo-ref[target]');
    refElements.forEach(element => {
      element.addEventListener('click', function() {
        const target = this.getAttribute('target');
        if (target) {
          // Handle email links differently
          if (target.startsWith('mailto:')) {
            window.location.href = target;
          } else {
            // Open other links in a new tab
            window.open(target, '_blank');
          }
        }
      });
      
      // Add title attribute for better UX
      if (!element.hasAttribute('title') && element.textContent.trim()) {
        element.setAttribute('title', element.textContent.trim());
      }
    });
    
    // Custom language detection and display
    const langElements = document.querySelectorAll('memo-div[{http://www.w3.org/XML/1998/namespace}lang]');
    langElements.forEach(element => {
      const lang = element.getAttribute('{http://www.w3.org/XML/1998/namespace}lang');
      const langNames = {
        'de': 'German',
        'en': 'English',
        'fr': 'French'
      };
      
      // Create language indicator
      if (lang && langNames[lang]) {
        const langIndicator = document.createElement('small');
        langIndicator.classList.add('text-muted', 'd-block', 'mb-3');
        langIndicator.innerText = `[${langNames[lang]}]`;
        element.insertBefore(langIndicator, element.firstChild.nextSibling);
      }
    });
  });
</script>