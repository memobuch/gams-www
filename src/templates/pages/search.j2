{% extends "parents/base.j2" %}
{% block content %}
    <h1 class="h3 fw-light">Volltextsuche</h1>
    <p>Personen des MEMO Projekts finden.</p>

    <script src="https://unpkg.com/dexie/dist/dexie.js"></script>

    <script src="/memo/static/js/projectDB.js"></script>

    <script>
        // TODO else read out project abbreviation from url?
        window.gams.projectDB.init("{{project.projectAbbr}}");
    
        window.gams.projectDB.populateDB()

        document.addEventListener("projectDB_populated", function(event) {
            console.log("Finished populating the project database", event)
            let searchString = new URL(window.location.href).hash.replace("#/", "")
            window.gams.projectDB.fulltextSearch(searchString)
        });


        document.addEventListener("projectDB_fulltext_hit", function(event) {
            console.log("projectDB_fulltext_hit", event)
            let digitalObjects = event.detail
            let html = `<ul>${digitalObjects.map(digitalObject => `<li><a href='/memo/objects/${digitalObject.db.id}'>${digitalObject.db.baseMetadata.title}</a></li>`).join('')}</ul>`
            document.getElementById("result").innerHTML = html
        });


    </script>

    <div id="result">
        <div class="spinner-border" role="status">
            
        </div>
    </div>
    
{% endblock %}