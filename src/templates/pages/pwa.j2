{% extends "parents/base.j2" %}
{% block content %}

<h3>MEMOR als App | Installation</h3>
<p>MEMOR lässt sich prototypisch als PWA (Progressive Web App) installieren.</p>
<p class="d-print-none">Sollte der Browser keine native Installationsmöglichkeit bieten, werden Anweisungen angezeigt, wie MEMOR manuell installiert werden kann.</p>

<button
  id="installBtn"
  class="browser-only mb-4 d-print-none"
  style="
    padding: 15px 25px;
    background-color: #244556;
    color: white;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    font-size: 16px;
  "
>
  <strong>MEMOR</strong> installieren
</button>

<p>QRCode zur Installationsseite:</p>

<script src="{{fn.asset('lib/qrcodejs/qrcode.min.js')}}"></script>

<div id="qrcode" class="mt-3"></div>
<script type="text/javascript">
  new QRCode(document.getElementById("qrcode"), {
    text: window.location.href,
    width: 150,
    height:150
  });
</script>

<button
  onclick="window.print()"
  class="browser-only mt-3 d-print-none"
  style="
    padding: 15px 25px;
    background-color: #244556;
    color: white;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    font-size: 16px;
  "
>
  Installationsanleitung drucken
</button>

<div id="installInstructions" hidden></div>

<style>
  .install-box {
    margin-top: 20px;
    padding: 16px;
    border-radius: 12px;
    background: #f4f4f4;
    line-height: 1.6;
    max-width: 520px;
  }

  .install-box h3 {
    margin-top: 0;
  }

  .install-box ol {
    padding-left: 20px;
  }

  .install-box small {
    display: block;
    margin-top: 12px;
    color: #666;
  }

  /**
   * Hide install button inside installed PWA
   */

  @media all and (display-mode: standalone) {
    .browser-only {
      display: none !important;
    }
  }

  @media all and (display-mode: fullscreen) {
    .browser-only {
      display: none !important;
    }
  }
</style>

<script>
let deferredPrompt = null;

const installBtn = document.getElementById("installBtn");
const instructions = document.getElementById("installInstructions");

/**
 * -------------------------------------------------------
 * iOS standalone detection
 * -------------------------------------------------------
 */

if (window.navigator.standalone === true) {
  installBtn.hidden = true;
  instructions.hidden = true;
}

/**
 * -------------------------------------------------------
 * Detect standalone mode
 * -------------------------------------------------------
 */

function isStandalone() {
  return (
    window.matchMedia("(display-mode: standalone)").matches ||
    window.matchMedia("(display-mode: fullscreen)").matches ||
    window.navigator.standalone === true
  );
}

/**
 * -------------------------------------------------------
 * Hide install UI inside installed app
 * -------------------------------------------------------
 */

window.addEventListener("DOMContentLoaded", () => {
  if (isStandalone()) {
    installBtn.hidden = true;
    instructions.hidden = true;
  }
});

/**
 * -------------------------------------------------------
 * Capture native install prompt
 * -------------------------------------------------------
 */

window.addEventListener("beforeinstallprompt", (event) => {
  event.preventDefault();
  deferredPrompt = event;
});

/**
 * -------------------------------------------------------
 * Detect platform/browser
 * -------------------------------------------------------
 */

function detectPlatform() {
  const ua = navigator.userAgent;

  const isIOS =
    /iPad|iPhone|iPod/.test(ua) ||
    (navigator.platform === "MacIntel" &&
      navigator.maxTouchPoints > 1);

  const isAndroid = /Android/i.test(ua);

  const isFirefox = /Firefox/i.test(ua);

  const isEdge = /Edg/i.test(ua);

  const isChrome =
    /Chrome/i.test(ua) &&
    !isEdge &&
    !/OPR|Opera/i.test(ua);

  const isSafari =
    /Safari/i.test(ua) &&
    !isChrome &&
    !isEdge &&
    !/Android/i.test(ua);

  return {
    isIOS,
    isAndroid,
    isFirefox,
    isEdge,
    isChrome,
    isSafari
  };
}

/**
 * -------------------------------------------------------
 * Show install instructions
 * -------------------------------------------------------
 */

function showInstructions() {
  const p = detectPlatform();

  let html = "";

  // iPhone / iPad Safari
  if (p.isIOS && p.isSafari) {
    html = `
      <div class="install-box">
        <h3>MEMOR auf iPhone/iPad installieren</h3>

        <ol>
          <li>
            In Safari auf das
            <strong>Teilen-Symbol</strong> tippen.
          </li>

          <li>
          
            <strong>„Zum Home-Bildschirm“</strong> wählen.
          </li>

          <li>
            Auf
            <strong>„Hinzufügen“</strong> tippen.
          </li>
        </ol>
      </div>
    `;
  }

  // Android Chrome
  else if (p.isAndroid && p.isChrome) {
    html = `
      <div class="install-box">
        <h3>MEMOR auf Android installieren</h3>

        <ol>
          <li>
            Das Chrome-Menü über die
            <strong>drei Punkte</strong> öffnen.
          </li>

          <li>
            
            <strong>„App installieren“</strong>
            wählen, oder
            <strong>„Zum Startbildschirm hinzufügen“</strong>.
          </li>

          <li>
            Installation betätigen.
          </li>
        </ol>
      </div>
    `;
  }

  // Android Firefox
  else if (p.isAndroid && p.isFirefox) {
    html = `
      <div class="install-box">
        <h3>MEMOR in Firefox auf Android installieren</h3>

        <ol>
          <li>
            Firefox-Menü öffnen.
          </li>

          <li>
            
            <strong>„Installieren“</strong>
            oder
            <strong>„Zum Startbildschirm hinzufügen“</strong>
            wählen.
          </li>

          <li>
            Installation bestätigen.
          </li>
        </ol>
      </div>
    `;
  }

  // Desktop Chrome / Edge
  else if (p.isChrome || p.isEdge) {
    html = `
      <div class="install-box">
        <h3>MEMOR auf dem Desktop installieren</h3>

        <ol>
          <li>
            Browser-Menü öffnen.
          </li>

          <li>
              <strong>„Installieren“</strong>,
              <strong>„App installieren“</strong>
              oder
              <strong>„MEMOR installieren“</strong>
              wählen.
          </li>

          <li>
            Installation bestätigen.
          </li>
        </ol>
      </div>
    `;
  }

  // Safari Desktop
  else if (p.isSafari) {
    html = `
      <div class="install-box">
        <h3>Installation in Safari</h3>

        <ol>
          <li>
            Auf das
            <strong>„Teilen-Symbol“</strong> klicken.
          </li>

          <li>
            
            <strong>„Zum Dock hinzufügen“</strong> klicken.
          </li>
        </ol>

        <small>
          Safari unterstützt die Installation von Web-Apps
          nur eingeschränkt.
          Für die beste Installationserfahrung Chrome nutzen.
        </small>
      </div>
    `;
  }

  // Generic fallback
  else {
    html = `
      <div class="install-box">
        <h3>MEMOR installieren</h3>

        <ol>
          <li>
            Browser-Menü öffnen.
          </li>

          <li>
            Nach
            <strong>„App installieren“</strong>,
            <strong>„Installieren“</strong>
            oder
            <strong>„Zum Startbildschirm hinzufügen“</strong> suchen.
          </li>

          <li>
            Installation bestätigen.
          </li>
        </ol>
      </div>
    `;
  }

  instructions.innerHTML = html;
  instructions.hidden = false;
}

/**
 * -------------------------------------------------------
 * Install button click
 * -------------------------------------------------------
 */

installBtn.addEventListener("click", async () => {

  // Native Chromium install dialog
  if (deferredPrompt) {

    deferredPrompt.prompt();

    const result = await deferredPrompt.userChoice;

    console.log("Install result:", result.outcome);

    deferredPrompt = null;

    return;
  }

  // Toggle instructions
  if (!instructions.hidden) {
    instructions.hidden = true;
  } else {
    showInstructions();
  }
});

/**
 * -------------------------------------------------------
 * After installation
 * -------------------------------------------------------
 */

window.addEventListener("appinstalled", () => {
  deferredPrompt = null;

  installBtn.hidden = true;
  instructions.hidden = true;
});
</script>

{% endblock %}