{% extends "parents/base.j2" %}
{% block content %}

<p>Elaborierterer Button; soll zeigen, wenn App schon installiert; oder Installieren nicht möglich</p>

    <h1 class="h3 fw-light">Installiere die App</h1>
    <div class="row mt-3">
        <div class="col-md-8">
            <div id="pwa-installed-box" class="alert alert-success d-none" role="status">
                Die App ist bereits installiert.
            </div>
            <div class="mb-3">
                <button id="pwa-install-button" class="btn btn-primary" type="button">
                    Installieren
                </button>
            </div>
            <div id="pwa-install-status" class="text-muted" aria-live="polite">
                Die Installation wird automatisch angeboten, wenn dein Browser die PWA unterstützt.
            </div>
        </div>
    </div>

    <script>
      (() => {
        let deferredPrompt = null;
        const installButton = document.getElementById('pwa-install-button');
        const statusText = document.getElementById('pwa-install-status');
        const installedBox = document.getElementById('pwa-installed-box');

        const isAppInstalled = () => {
          return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        };

        const showInstalledState = () => {
          installedBox.classList.remove('d-none');
          installButton.style.display = 'none';
          statusText.textContent = 'Die App ist bereits installiert.';
        };

        const setManualFallback = () => {
          installButton.textContent = 'Installationsanleitung';
          installButton.disabled = false;
          statusText.textContent = 'Der automatische Installationsprompt ist nicht verfügbar. Verwende das Browser-Menü und wähle "Zum Home-Bildschirm hinzufügen" oder "Installieren". Bei Apple-Geräten öffne die Seite in Safari und nutze die Teilen-Funktion, um die App zum Home-Bildschirm hinzuzufügen.';
        };

        const updateInstallState = () => {
          if (isAppInstalled()) {
            showInstalledState();
            return true;
          }
          return false;
        };

        if (!updateInstallState()) {
          installButton.disabled = true;
          installButton.textContent = 'Warten auf Installationsprompt...';

          window.addEventListener('beforeinstallprompt', (event) => {
            event.preventDefault();
            deferredPrompt = event;
            installButton.textContent = 'PWA installieren';
            installButton.disabled = false;
            statusText.textContent = 'Klicke auf den Button, um die PWA zu installieren.';
          });

          setTimeout(() => {
            if (!deferredPrompt && !isAppInstalled()) {
              setManualFallback();
            }
          }, 1000);
        }

        installButton.addEventListener('click', async () => {
          if (isAppInstalled()) {
            showInstalledState();
            return;
          }

          if (deferredPrompt) {
            installButton.disabled = true;
            deferredPrompt.prompt();
            const choiceResult = await deferredPrompt.userChoice;

            if (choiceResult.outcome === 'accepted') {
              showInstalledState();
            } else {
              statusText.textContent = 'Installation abgebrochen. Du kannst es erneut versuchen.';
              installButton.disabled = false;
            }

            deferredPrompt = null;
          } else {
            setManualFallback();
          }
        });

        window.addEventListener('appinstalled', () => {
          showInstalledState();
        });
      })();
    </script>
{% endblock %}
