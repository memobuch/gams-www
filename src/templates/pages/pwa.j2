{% extends "parents/base.j2" %}
{% block content %}

<h1>MEMOR installieren</h1>
<p>Alle meine Entchen</p>

<button
  id="installBtn"
  style="
    padding: 10px 20px;
    background-color: #244556;
    color: white;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    font-size: 16px;
  "
>
  Installiere MEMOR als App
</button>

<div id="installInstructions" hidden></div>

<style>
  .install-box {
    margin-top: 20px;
    padding: 16px;
    border-radius: 12px;
    background: #f4f4f4;
    line-height: 1.6;
    max-width: 520px;
  }

  .install-box h3 {
    margin-top: 0;
  }

  .install-box ol {
    padding-left: 20px;
  }

  .install-box small {
    display: block;
    margin-top: 12px;
    color: #666;
  }
</style>

<script>
let deferredPrompt = null;

const installBtn = document.getElementById("installBtn");
const instructions = document.getElementById("installInstructions");

/**
 * -------------------------------------------------------
 * Detect standalone mode
 * -------------------------------------------------------
 */

function isStandalone() {
  return (
    window.matchMedia("(display-mode: standalone)").matches ||
    window.matchMedia("(display-mode: fullscreen)").matches ||
    window.navigator.standalone === true
  );
}

/**
 * -------------------------------------------------------
 * Hide install UI inside installed app
 * -------------------------------------------------------
 */

window.addEventListener("DOMContentLoaded", () => {
  if (isStandalone()) {
    installBtn.hidden = true;
    instructions.hidden = true;
  }
});

/**
 * -------------------------------------------------------
 * Capture native install prompt
 * -------------------------------------------------------
 */

window.addEventListener("beforeinstallprompt", (event) => {
  event.preventDefault();
  deferredPrompt = event;
});

/**
 * -------------------------------------------------------
 * Detect platform/browser
 * -------------------------------------------------------
 */

function detectPlatform() {
  const ua = navigator.userAgent;

  const isIOS =
    /iPad|iPhone|iPod/.test(ua) ||
    (navigator.platform === "MacIntel" &&
      navigator.maxTouchPoints > 1);

  const isAndroid = /Android/i.test(ua);

  const isFirefox = /Firefox/i.test(ua);

  const isEdge = /Edg/i.test(ua);

  const isChrome =
    /Chrome/i.test(ua) &&
    !isEdge &&
    !/OPR|Opera/i.test(ua);

  const isSafari =
    /Safari/i.test(ua) &&
    !isChrome &&
    !isEdge &&
    !/Android/i.test(ua);

  return {
    isIOS,
    isAndroid,
    isFirefox,
    isEdge,
    isChrome,
    isSafari
  };
}

/**
 * -------------------------------------------------------
 * Show OS/browser-specific instructions
 * -------------------------------------------------------
 */

function showInstructions() {
  const p = detectPlatform();

  let html = "";

  // iPhone / iPad Safari
  if (p.isIOS && p.isSafari) {
    html = `
      <div class="install-box">
        <h3>MEMOR auf iPhone/iPad installieren</h3>

        <ol>
          <li>
            Tippe unten in Safari auf das
            <strong>Teilen-Symbol</strong>.
          </li>

          <li>
            Wähle
            <strong>„Zum Home-Bildschirm“</strong>.
          </li>

          <li>
            Tippe auf
            <strong>„Hinzufügen“</strong>.
          </li>
        </ol>
      </div>
    `;
  }

  // Android Chrome
  else if (p.isAndroid && p.isChrome) {
    html = `
      <div class="install-box">
        <h3>MEMOR auf Android installieren</h3>

        <ol>
          <li>
            Öffne das Chrome-Menü über die
            <strong>drei Punkte</strong>.
          </li>

          <li>
            Wähle
            <strong>„App installieren“</strong>
            oder
            <strong>„Zum Startbildschirm hinzufügen“</strong>.
          </li>

          <li>
            Bestätige die Installation.
          </li>
        </ol>
      </div>
    `;
  }

  // Android Firefox
  else if (p.isAndroid && p.isFirefox) {
    html = `
      <div class="install-box">
        <h3>MEMOR in Firefox auf Android installieren</h3>

        <ol>
          <li>
            Öffne das Firefox-Menü.
          </li>

          <li>
            Wähle
            <strong>„Installieren“</strong>
            oder
            <strong>„Zum Startbildschirm hinzufügen“</strong>.
          </li>

          <li>
            Bestätige die Installation.
          </li>
        </ol>
      </div>
    `;
  }

  // Desktop Chrome / Edge
  else if (p.isChrome || p.isEdge) {
    html = `
      <div class="install-box">
        <h3>MEMOR auf dem Desktop installieren</h3>

        <ol>
          <li>
            Öffne das Browser-Menü.
          </li>

          <li>
            Wähle
            <strong>„MEMOR installieren“</strong>
            oder
            <strong>„App installieren“</strong>.
          </li>

          <li>
            Bestätige die Installation.
          </li>
        </ol>
      </div>
    `;
  }

  // Safari Desktop
  else if (p.isSafari) {
    html = `
      <div class="install-box">
        <h3>Installation in Safari</h3>

        <ol>
          <li>
            Klicke auf das
            <strong>„Teilen-Symbol"</strong>.
          </li>

          <li>
            Klicke auf
            <strong>„Zum Dock hinzufügen“</strong>.
          </li>
        </ol>

        <small>
          Safari unterstützt die Installation von Web-Apps
          nur eingeschränkt.
          Nutze für die beste Installationserfahrung Chrome.
        </small>
      </div>
    `;
  }

  // Generic fallback
  else {
    html = `
      <div class="install-box">
        <h3>MEMOR installieren</h3>

        <ol>
          <li>
            Öffne das Menü deines Browsers.
          </li>

          <li>
            Suche nach
            <strong>„App installieren“</strong>,
            <strong>„Installieren“</strong>
            oder
            <strong>„Zum Startbildschirm hinzufügen“</strong>.
          </li>

          <li>
            Bestätige die Installation.
          </li>
        </ol>
      </div>
    `;
  }

  instructions.innerHTML = html;
  instructions.hidden = false;
}

/**
 * -------------------------------------------------------
 * Install button click
 * -------------------------------------------------------
 */

installBtn.addEventListener("click", async () => {

  // Native Chromium install dialog
  if (deferredPrompt) {

    deferredPrompt.prompt();

    const result = await deferredPrompt.userChoice;

    console.log("Install result:", result.outcome);

    deferredPrompt = null;

    return;
  }

  // Otherwise show manual instructions
  showInstructions();
});

/**
 * -------------------------------------------------------
 * After installation
 * -------------------------------------------------------
 */

window.addEventListener("appinstalled", () => {
  deferredPrompt = null;

  installBtn.hidden = true;
  instructions.hidden = true;
});
</script>

{% endblock %}