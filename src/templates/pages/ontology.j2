{% extends "parents/base.j2" %}
{% block content %}

<div class="container py-4">

    <h1 data-i18n="TODO" class="h3 fw-light">
        MEMOR Ontology
    </h1>

    <p class="text-muted">
        Interactive documentation of the MEMOR ontology.
    </p>

    <div class="mb-5">
        <iframe
            style="min-width: 100%; min-height: 80vh; border: 1px solid #ccc;"
            src="https://service.tib.eu/webvowl/#iri={{context.env.DANGEROUS_GAMS5_PRODUCTION_ORIGIN}}/api/curation/v1/projects/memor/objects/memor.ontology/datastreams/ONTOLOGY.ttl/content">
        </iframe>
    </div>

    <div id="ontology-content">
        <div class="alert alert-info">
            Loading ontology table...
        </div>
    </div>

</div>

<script>

(async () => {

    const container = document.querySelector("#ontology-content");

    const turtleUrl =
        "{{context.env.GAMS_API_ORIGIN}}/api/curation/v1/projects/memor/objects/memor.ontology/datastreams/ONTOLOGY.ttl/content";

    try {

        const response = await fetch(turtleUrl);

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const turtle = await response.text();

        const classes = [];
        const objectProperties = [];
        const datatypeProperties = [];

        const statements = turtle
            .split(/\n(?=memor:)/)
            .map(s => s.trim())
            .filter(s => s.startsWith("memor:"));

        statements.forEach(statement => {

            const nameMatch = statement.match(/^(memor:[^\s]+)/);

            if (!nameMatch) return;

            const entry = {
                name: nameMatch[1],
                label: extractLabels(statement),
                comment: extractLiteralWithLang(statement, "rdfs:comment"),
                subclassOf: extractMultiple(statement, "rdfs:subClassOf"),
                subpropertyOf: extractMultiple(statement, "rdfs:subPropertyOf"),
                domain: extractSingle(statement, "rdfs:domain"),
                range: extractSingle(statement, "rdfs:range")
            };

            if (statement.includes("owl:Class")) {
                classes.push(entry);
            }

            else if (statement.includes("owl:ObjectProperty")) {
                objectProperties.push(entry);
            }

            else if (statement.includes("owl:DatatypeProperty")) {
                datatypeProperties.push(entry);
            }

        });

        container.innerHTML = `
            ${renderTable("Classes", classes, "class")}
            ${renderTable("Object Properties", objectProperties, "property")}
            ${renderTable("Datatype Properties", datatypeProperties, "property")}
        `;

    } catch(error) {

        console.error(error);

        container.innerHTML = `
            <div class="alert alert-danger">
                Failed to load ontology table.<br>
                <code>${escapeHtml(error.message)}</code>
            </div>
        `;
    }

    function extractSingle(statement, predicate) {

        const regex = new RegExp(
            predicate.replace(":", "\\:") + "\\s+([^;\\.]+)",
            "m"
        );

        const match = statement.match(regex);

        return match
            ? cleanValue(match[1])
            : "";
    }

    function extractMultiple(statement, predicate) {

        const regex = new RegExp(
            predicate.replace(":", "\\:") + "\\s+([^;\\.]+)",
            "gm"
        );

        const values = [];
        let match;

        while ((match = regex.exec(statement)) !== null) {
            values.push(cleanValue(match[1]));
        }

        return values;
    }

    function extractLabels(statement) {

        const labels = [];
        const regex = /"([^"]+)"@([a-zA-Z-]+)/g;
        let match;

        while ((match = regex.exec(statement)) !== null) {

            labels.push(`
                <div class="mb-1">
                    ${escapeHtml(match[1])}
                    <span class="badge bg-secondary ms-1">
                        ${escapeHtml(match[2])}
                    </span>
                </div>
            `);
        }

        return labels.join("");
    }

    function extractLiteralWithLang(statement, predicate) {

        const regex = new RegExp(
            predicate.replace(":", "\\:") + '\\s+"([^"]+)"@([a-zA-Z-]+)',
            "m"
        );

        const match = statement.match(regex);

        if (!match) return "";

        return `
            ${escapeHtml(match[1])}
            <span class="badge bg-secondary ms-1">
                ${escapeHtml(match[2])}
            </span>
        `;
    }

    function cleanValue(value) {

        return value
            .trim()
            .replaceAll('"', "")
            .replaceAll(";", "")
            .replaceAll(".", "")
            .trim();
    }

    function escapeHtml(value) {

        return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function renderTable(title, entries, type) {

        if (!entries.length) {

            return `
                <div class="mb-4">
                    <h2 class="h4">
                        ${escapeHtml(title)}
                    </h2>

                    <div class="alert alert-warning">
                        No entries found.
                    </div>
                </div>
            `;
        }

        return `
            <div class="mb-5">

                <h2 class="h4">
                    ${escapeHtml(title)}
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Label</th>
                                <th>Comment</th>
                                <th>
                                    ${type === "class"
                                        ? "Subclass Of"
                                        : "Subproperty Of"
                                    }
                                </th>

                                ${type !== "class"
                                    ? `
                                        <th>Domain</th>
                                        <th>Range</th>
                                    `
                                    : ""
                                }
                            </tr>
                        </thead>

                        <tbody>
                            ${entries.map(entry => `
                                <tr>
                                    <td>
                                        <code>${escapeHtml(entry.name)}</code>
                                    </td>

                                    <td>
                                        ${entry.label}
                                    </td>

                                    <td>
                                        ${entry.comment}
                                    </td>

                                    <td>
                                        ${(type === "class"
                                            ? entry.subclassOf
                                            : entry.subpropertyOf
                                        )
                                        .map(v => `
                                            <div>
                                                <code>${escapeHtml(v)}</code>
                                            </div>
                                        `)
                                        .join("")}
                                    </td>

                                    ${type !== "class"
                                        ? `
                                            <td>
                                                <code>${escapeHtml(entry.domain)}</code>
                                            </td>

                                            <td>
                                                <code>${escapeHtml(entry.range)}</code>
                                            </td>
                                        `
                                        : ""
                                    }
                                </tr>
                            `).join("")}
                        </tbody>

                    </table>

                </div>

            </div>
        `;
    }

})();
</script>

{% endblock %}