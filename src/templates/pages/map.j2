{% extends "parents/base.j2" %}
{% block content %}
    <h1 class="h3 fw-light">Karte</h1>
    <p>Karte der Opfer erfasst von MEMO</p>

    <!-- ProjectDB files -->
    <script src="https://cdn.jsdelivr.net/npm/dexie@3.0.3/dist/dexie.min.js"></script>
    <script src="/memo/static/js/projectDB.js"></script>

    <br/>
    <section>

         <div class="row">
            <div id="filters" class="col-md-4">
                <div class="border p-2">
                    <h3 class="h5 fw-light mt-2">Filterung</h2>
                    <br/>
                    <!-- TODO: button for filter + map fullscreen-->
                    {# <div class="form-check"> <!-- Checkbox for each reason -->
                        <input class="form-check-input" type="checkbox" id="resistance" value="resistance" checked onchange="drawPersons()">
                        <label class="form-check-label" for="resistance">Widerstand</label>
                    </div>
                    <div class="form-check"> <!-- Checkbox for each reason -->
                        <input class="form-check-input" type="checkbox" id="jewish" value="jewish" checked onchange="drawPersons()">
                        <label class="form-check-label" for="jewish">Jüdische Opfer</label>
                    </div>
                    <div class="form-check"> <!-- Checkbox for each reason -->
                        <input class="form-check-input" type="checkbox" id="yenish" value="yenish" checked onchange="drawPersons()">
                        <label class="form-check-label" for="yenish">Jenische</label>
                    </div>
                    <div class="form-check"> <!-- Checkbox for each reason -->
                        <input class="form-check-input" type="checkbox" id="euthanasia" value="euthanasia" checked onchange="drawPersons()">
                        <label class="form-check-label" for="euthanasia">NS-Euthanasieopfer</label>
                    </div> #}
                    <div class="form-check"> <!-- Checkbox for each reason -->
                        <input class="form-check-input" type="checkbox" id="roma" value="euthanasia" checked onchange="drawPersons()">
                        <label class="form-check-label" for="euthanasia">Roma/Romnija und Sinti/Sintize</label>
                    </div>
                    <br/>
                    <div id="range-container">
                        <div>
                        <label for="startDateRange"></label>
                        <input onchange="drawPersons()" type="range" id="startDateRange" min="1900" max="2100" value="1900" style="background: orange;">
                        <span id="startDateRangeValue">1900</span>
                        </div>
                        <div>
                        <label for="endDateRange"></label>
                        <input onchange="drawPersons()" type="range" id="endDateRange" min="1900" max="2100" value="2100" style="background: orange;">
                        <span id="endDateRangeValue">2100</span>
                        </div>
                    </div>
                    <div id="legend" class="mt-3"> <!-- TODO: remove legend for now -->
                    </div>
                    <div>
                        <button id="reset-filters" class="btn btn-secondary mt-3" onclick="clearMap()">Alle Filter zurücksetzen</button>
                    </div>
                </div>
            </div>
            <!-- Map container -->
            <div id="map" class="col-md-8" style="min-height: 100vh;">

            </div>
        </div>
        
        <!-- Leaflet map -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

        {# <div style="height:100vh;" id="map"></div> #}

        <script>
            // initializing the leaflet map
            var map = L.map('map', {
                // speeds up rendering performance (markers are no longer individual dom elements )
                // https://stackoverflow.com/questions/43015854/large-dataset-of-markers-or-dots-in-leaflet
                preferCanvas: true
            }).setView([48, 14], 7);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            // clustering 
            // https://stackoverflow.com/questions/43015854/large-dataset-of-markers-or-dots-in-leaflet
            // cluster lib: https://github.com/mapbox/supercluster

            // layer for markers
            let markersLayer = L.layerGroup().addTo(map);

            // init projectDB -> TODO might be done on every page (base.j2)? 
            window.gams.projectDB.initDB("{{project.projectAbbr}}", new Date("1999"));


            // per found person in the projectDB, add a marker to the map
            document.addEventListener("PROJECTDB_READY", event => {
                drawPersons();
            });


            const drawPersons = () => {
                markersLayer.clearLayers();

                // user input
                let userStartDate = new Date(document.getElementById('startDateRange').value)
                let userEndDate = new Date(document.getElementById('endDateRange').value);

                // supplay entitiy tags
                let entityTags = [];
                if (!document.getElementById('roma').checked) {
                    entityTags.push("roma");
                }
                //if (!document.getElementById('jewish').checked) {
                //    entityTags.push("juedischeopfer");
                //}


                // construct searchObject
                let searchObject = {
                    // TODO rename entityStartDate
                    startDate: userStartDate,
                    // TODO rename enitityEndDate
                    endDate: userEndDate,
                    entityTags: entityTags,
                    entityTypes: ["person"],
                };

                gams.projectDB.advancedSearch(searchObject, (val) => {
                    drawPersonToMap(val);
                });
                
            }


            const drawPersonToMap = (val) => {
                let latLongString = val.props.entityLongLat.replace(" ", "");
                let latLong = latLongString.split(",");
                let lat = parseFloat(latLong[0]);
                let long = parseFloat(latLong[1]);
                //L.marker([lat, long]).addTo(map);

                // marker will stay scale per zoom level
                // (opposed to L.circle which will NOT scale with zoom level)
                var circle = L.circleMarker([lat, long], {
                    color: 'black',
                    fillColor: 'black',
                    fillOpacity: 1,
                    radius: 3
                });


                markersLayer.addLayer(circle);

                let popup = `
                    <div>
                        <img alt=" (Image missing)" style="max-width:10em;" src="http://localhost:18085/api/v1/projects/memo/objects/${val.db.id}/datastreams/1.jpg/content"/>
                        <hr/>
                        <h3 class="h6">${val.db.baseMetadata.title}</h3>
                        <p>Adresse: ${val.props.entityLocationLabels.join(", ")}</p>
                        <p>Kategorie(n): ${val.props.entityTags}</p>
                        <p><a target="_blank" href="/{{project.projectAbbr}}/objects/${val.db.id}">Zur Detailseite</a></p>
                    </div>
                `

                circle.bindPopup(popup);
            }


            const clearMap = () => {
                markersLayer.clearLayers();
            }

        </script>

    </section>

{% endblock %}