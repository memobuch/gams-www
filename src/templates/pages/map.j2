{% extends "parents/base.j2" %}
{% block content %}
    <h1 class="h3 fw-light">Karte</h1>
    <p>Karte der Opfer erfasst von MEMO</p>

    <!-- ProjectDB files -->
    <script src="https://unpkg.com/dexie/dist/dexie.js"></script>
    <script src="/memo/static/js/projectDB.js"></script>

    <section>
        <!-- Leaflet map -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <div style="height:100vh;" id="map"></div>

        <script>
            // initializing the leaflet map
            var map = L.map('map', {
                // speeds up rendering performance (markers are no longer individual dom elements )
                // https://stackoverflow.com/questions/43015854/large-dataset-of-markers-or-dots-in-leaflet
                preferCanvas: true
            }).setView([48, 14], 7);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);


            // clustering 
            // https://stackoverflow.com/questions/43015854/large-dataset-of-markers-or-dots-in-leaflet
            // cluster lib: https://github.com/mapbox/supercluster

            // init projectDB -> TODO might be done on every page (base.j2)? 
            window.gams.projectDB.initDB("{{project.projectAbbr}}");

            // per found person in the projectDB, add a marker to the map
            document.addEventListener("projectDB_populated", event => {
                gams.projectDB.dcTypeSearch("person", (val) => {
                    console.log(val);
                    let latLongString = val.props.entityLongLat.replace(" ", "");
                    let latLong = latLongString.split(",");
                    let lat = parseFloat(latLong[0]);
                    let long = parseFloat(latLong[1]);
                    //L.marker([lat, long]).addTo(map);

                    // marker will stay scale per zoom level
                    // (opposed to L.circle which will NOT scale with zoom level)
                    var circle = L.circleMarker([lat, long], {
                        color: 'black',
                        fillColor: 'black',
                        fillOpacity: 1,
                        radius: 3
                    }).addTo(map);

                    let popup = `
                        <div>
                            <img alt=" (Image missing)" style="max-width:10em;" src="http://localhost:18085/api/v1/projects/memo/objects/${val.db.id}/datastreams/1.jpg/content"/>
                            <hr/>
                            <h3 class="h6">${val.db.baseMetadata.title}</h3>
                            <p>Adresse: ${val.props.entityLocationLabels.join(", ")}</p>
                            <p>Kategorie(n): ${val.props.entityTags}</p>
                            <p><a target="_blank" href="/{{project.projectAbbr}}/objects/${val.db.id}">Zur Detailseite</a></p>
                        </div>
                    `

                    circle.bindPopup(popup);

                })

            });

        </script>

    </section>

{% endblock %}