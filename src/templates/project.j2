{% extends "parents/base.j2" %}
{% import 'macros/dc_stats.j2' as macros with context %}
{% block content %}

    {# <h1>{{ context.project.projectTitle }}</h1> #}
    <h1>{{ context.project.projectAbbr | upper }}</h1>
    {# <h2 class="h3 fw-light">{{ context.project.projectSubTitle }}</h2> #}
    <h2 data-i18n="memo_title" class="h3 fw-light">Digitales Gedenkbuch der Stadt Graz</h2>
    <hr/>
    {# <pre>{{ context | tojson(indent=2) }}</pre> #}
    <div class="row">
        <div class="col-md-4">
            <div class="p-2" style="background: lightblue;">
                <h2 class="h4">Über MEMOR</h2>
                <p>MEMOR ist das digitale Denkmal für die Grazer Opfer des Nationalsozialismus. Es dokumentiert die Biographien aller Grazer Opfer des Nationalsozialismus zwischen 1938 und 1945 und verzeichnet sie an ihren letzten freiwilligen Wohnadressen in der Stadt Graz. </p>
                <p>MEMOR dient sowohl als historisches Archiv als auch als Bildungsinstrument und schafft eine interaktive Plattform, die individuelle Opfergeschichten würdigt und gleichzeitig breitere Verfolgungsmuster sichtbar macht. Durch die Digitalisierung der Geschichte der Opfer sowie durch die lokale Verortung der einzelnen Verfolgungsgeschichten im Grazer Stadtraum ist es für alle jederzeit möglich, mehr über einzelne Personen, Personengruppen aber auch über einzelne Bezirke oder Straßen zu erfahren. </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-2">
                <h2 class="h4">Über die Opfer</h2>
                <p>Aktuell werden recherchierte NS-Opfer, die zum Zeitpunkt der NS-Machtübernahme im Jahr 1938 im Grazer Stadtgebiet ihren Lebensmittelpunkt hatten, in MEMOR dokumentiert und vorgestellt. Sie werden entsprechend den Gründen ihrer Verfolgung vorgestellt.</p>
                <p>Ziel ist es, alle Grazer NS-Opfer in Erinnerung zu halten und ihnen ihre Geschichte zurückzugeben aber auch ihnen ein „Gesicht“ zu geben. Um das zu erreichen, sind wir auf Ihre Mitarbeit angewiesen. Sollten Sie weiterführende Informationen zu den hier verzeichneten Opfern wie auch uns bislang nicht bekannten Opfern haben, so bitten wir Sie um Kontaktaufnahme mit unserem Team.</p>
                <p>Rückmeldungen: memor.graz@uni-graz.at</p>
            </div>
        </div>
        <div class="col">
            <div class="p-2">
                <h2 class="h4">Kernfunktionalitäten</h2>
                <ol>
                    <li><a class="text-dark" href="{{context._root_path}}/map.html">Karte der letzten Wohnorte</a>  der Grazer Opfer des Nationalsozialismus.</li>
                    <li><a class="text-dark" href="{{context._root_path}}/objects/">Biographie-Übersicht</a> mit Suchfunktion.</li>
                    <li><a class="text-dark" href="{{context._root_path}}/objects/memor.person.9/">Detailansichten zu einzelnen Personen</a> (Am Beispiel von Abraham Asatanowicz)</li>
                    <li><a class="text-dark" href="{{context._root_path}}/about.html">Allgemeine Projektinformation</a></li>
                </ol>
                <br/>
                <h2 class="h5">MEMOR als digitale Edition</h2>
                <a href="{{context._root_path}}/datamodel.html" class="text-dark text-decoration-none" data-bs-toggle="tooltip" data-bs-title="MEMOR wurde als digitale Edition mit Hilfe des Geisteswissenschaftlichen Asset Management Systems GAMS umgesetzt">
                    <div class="border">
                        <img alt="GAMS" loading="lazy" width="80" src="{{fn.asset('img/gams5_image_only.jpg')}}"/><span class="ps-md-2">Digitale Infrastruktur GAMS</span>
                    </div>
                </a>

                <ul class="mt-2" style="">
                    <li><a class="text-dark" href="{{context._root_path}}/datamodel.html">FAIR Forschungsdaten</a>: <small>MEMOR stellt erschlossene Forschungsdaten nach den Prinzipien von FAIR und Open Science bereit.</small></li>
                    <li><a class="text-dark" href="https://digital-humanities.uni-graz.at/" target="_blank">DDH</a> Institut für Digitale Geisteswissenschaften</li>
                </ul>
            </div>
        </div>
    </div>

    <br/>

     <!-- Element to contain animated typing -->
    <div>In Erinnerung an: <svg class="mb-3" data-i18n="[data-bs-title]home.typed.tooltip" data-bs-toggle="tooltip" data-bs-title="Default tooltip" width="20px" height="20px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#000000"><path d="M9 9C9 5.49997 14.5 5.5 14.5 9C14.5 11.5 12 10.9999 12 13.9999" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 18.01L12.01 17.9989" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 13.8214 2.48697 15.5291 3.33782 17L2.5 21.5L7 20.6622C8.47087 21.513 10.1786 22 12 22Z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <h2 style="min-height: 1.1em;"><span id="element"></span></h2>
    </div>

    <!-- Load library typed.js 3.0.0. -->
    <script src="{{fn.asset('lib/typed/typed.umd.js')}}"></script>

    <!-- Setup and start animation! -->
    <script>

        (async () => {

            let resp = await fetch("{{context.env.GAMS_API_ORIGIN}}/api/curation/v1/projects/{{context.env.PROJECT_ABBR}}/objects?format=json&tag=person");
            let json = await resp.json();

            let personNames = json.results.map(result => {

                let name = result.baseMetadata.title.replace(" (person description)", "");
                return name;
            });

            var typed = new Typed('#element', {
                strings: personNames,
                typeSpeed: 100,
                backSpeed: 100,
                shuffle: true,
                loop: true
            });

        })();
    </script>



    <div class="gallery-container">
        <div class="image-grid" id="randomImageGrid">
            {% set image_pool = [10,15,16,17,19,21,22,29,30,36,40,47,48,49,50,54,63,64,65,81,82,83,84,92,99,111,114,171,330,369,812,1253,1252,1246,1245,1236,1235,1230,1220,1219,1218,1213,1212,1208,1206,1205,1203,1199,1187,1183,1182,1178,1162,1118,1117,1113,1112,1109,1107] %}
            
            {% for person_id in image_pool %}
            <a href="{{context._root_path}}/objects/memor.person.{{ person_id }}/" class="image-card random-image-item" style="display: none;">
                <!-- Use loading="lazy" to prevent downloading all images on initial load -->
                <img loading="lazy" src="{{context.env.IIIF_IMAGE_SERVER_ORIGIN}}/iiif/3/memor%2fmemor.person.{{ person_id }}%2f1.jpg/full/max/0/default.jpg" alt="Person {{ person_id }}">
                <div class="image-overlay">
                    <div class="overlay-content">
                        <div data-i18n="img.detail.link;[title]img.detail.title;" class="view-icon">View person</div>
                    </div>
                </div> 
            </a>
            {% endfor %}
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const allImages = Array.from(document.querySelectorAll('.random-image-item'));
            
            // Shuffle the array of image elements
            for (let i = allImages.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [allImages[i], allImages[j]] = [allImages[j], allImages[i]];
            }
            
            // Select how many random images to show
            const numToShow = 18; 
            
            // Show the randomly selected images
            for (let i = 0; i < numToShow && i < allImages.length; i++) {
                allImages[i].style.display = ''; // Remove display: none
            }

            // Remove loading animation once displayed images are loaded
            document.querySelectorAll('.image-card img').forEach(img => {
                if (img.complete) {
                    img.classList.add('loaded');
                } else {
                    img.addEventListener('load', function() {
                        this.classList.add('loaded');
                    });
                }
            });
        });
    </script>


    {% include "includes/memor_death_country_box.j2" %}

    <br/>
    <br/>

    <div id="searchResults"></div>
    {{ macros.dc_stats('searchResults') }}



     <style>

        .gallery-container {
            
        }

        .image-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: .5rem;
        }

        .image-card {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }

        .image-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
        }

        .image-card img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }

        .image-card:hover img {
            transform: scale(1.05);
        }

        .image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.7) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
            display: flex;
            align-items: flex-end;
            padding: 1rem;
            color: white;
        }

        .image-card:hover .image-overlay {
            opacity: 1;
        }

        .overlay-content {
            width: 100%;
        }

        .view-icon {
            font-size: 1.2rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .view-icon::before {
            content: '🔍';
            font-size: 1.5rem;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .image-grid {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 1rem;
            }

            .image-card img {
                height: 250px;
            }
        }

    </style>

{% endblock %}