{% extends "parents/base.j2" %}
{% import 'macros/dc_stats.j2' as macros with context %}
{% block content %}

    {# <h1>{{ context.project.projectTitle }}</h1> #}
    <h1>MEMO</h1>
    {# <h2 class="h3 fw-light">{{ context.project.projectSubTitle }}</h2> #}
    <h2 class="h3 fw-light">Digitales Memobuch der Stadt Graz</h2>
    <hr/>
    {# <pre>{{ context | tojson(indent=2) }}</pre> #}
    <div class="row">
        <div class="col-md-4">
            <div class="p-2" style="background: lightblue;">
                <h2 class="h4">Historischer Kontext und Zielsetzung</h2>
                <p>Das MEMO Digitale Memobuch ist ein digitales Denkmal, das sich der Dokumentation und Visualisierung der Verfolgung von Opfern des Nationalsozialismus in Graz zwischen 1938 und 1945 widmet. Das Projekt dient sowohl als historisches Archiv als auch als Bildungsinstrument und schafft eine interaktive Plattform, die individuelle Opfergeschichten würdigt und gleichzeitig breitere Verfolgungsmuster sichtbar macht. Durch die Digitalisierung und Kartierung dieses dunklen Kapitels der Geschichte stellt das Projekt sicher, dass diese Geschichten für ein zeitgenössisches Publikum zugänglich und bedeutsam bleiben.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-2">
                <h2 class="h4">Datensatz und Umfang</h2>
                <p>Der aktuelle Datensatz umfasst 691 dokumentierte Personen über 1.352 einzelne Ereignisse und zeichnet ein umfassendes Bild der Verfolgung in Graz während der NS-Zeit. Jedes Ereignis ist nach Typ kategorisiert – einschließlich freiwilliger Wohnsitz, Zwangswohnsitz, Inhaftierung, Flucht und Tod – und mit spezifischen Personen verknüpft, für die biografische Informationen vorliegen. Die Daten sind in GAMS (Geisteswissenschaftliches Asset Management System) integriert, das vollständige biografische Details für jedes Opfer bereitstellt und so eine reichhaltige, miteinander verknüpfte historische Dokumentation schafft.</p>
            </div>
        </div>
        <div class="col">
            <div class="p-2">
                <h2 class="h4">Technische Umsetzung</h2>
                <p>Das Projekt hat sich durch mehrere Iterationen entwickelt und gipfelt in einer ausgefeilten Karten-Visualisierung mit Globe.gl und Three.js. Die Anwendung bietet duale Ansichtsmodi (aggregierte Kreise und individuelle Punkte), umfassende Filterung sowohl nach Ereignistypen als auch nach Opferkategorien sowie intelligentes Clustering, das Ereignisse nach Typ trennt, anstatt sie in generische Cluster zu aggregieren. Die Implementierung priorisiert clientseitige Verarbeitung und arbeitet ohne externe API-Abhängigkeiten, was langfristige Zugänglichkeit und Zuverlässigkeit für dieses öffentliche Denkmal gewährleistet.</p>
            </div>
        </div>
    </div>
    
    
    <p>{{ context.project.projectDesc }}</p>

    <div class="gallery-container">
        <div class="image-grid" id="randomImageGrid">
            {% set image_pool = [
                ('99', '1'), ('30', '1'), ('30', '2'), ('19', '1'), ('84', '2'),
                ('81', '1'), ('81', '2'), ('47', '1'), ('47', '2'), ('16', '1'),
                ('36', '1'), ('21', '1'), ('369', '1'), ('15', '1'),
                ('1', '1'), ('2', '1'), ('3', '1'), ('4', '1'), ('5', '1'),
                ('6', '1'), ('7', '1'), ('8', '1'), ('9', '1'), ('10', '1'),
                ('11', '1'), ('12', '1'), ('13', '1'), ('14', '1'), ('17', '1'),
                ('18', '1'), ('20', '1'), ('22', '1'), ('23', '1'), ('24', '1'),
                ('25', '1'), ('26', '1'), ('27', '1'), ('28', '1'), ('29', '1'),
                ('31', '1'), ('32', '1'), ('33', '1'), ('34', '1'), ('35', '1'),
                ('37', '1'), ('38', '1'), ('39', '1'), ('40', '1'), ('41', '1'),
                ('42', '1'), ('43', '1'), ('44', '1'), ('45', '1'), ('46', '1')
            ] %}
            
            {% for person_id, img_id in image_pool %}
            <a href="{{context._root_path}}/objects/memo.person.{{ person_id }}/" class="image-card random-image-item" style="display: none;">
                <!-- Use loading="lazy" to prevent downloading all 50 images on initial load -->
                <img loading="lazy" src="{{context.env.IIIF_IMAGE_SERVER_ORIGIN}}/iiif/2/memo%2fmemo.person.{{ person_id }}%2f{{ img_id }}.jpg/full/,300/0/default.jpg" alt="Person {{ person_id }}">
                <div class="image-overlay">
                    <div class="overlay-content">
                        <div data-i18n="img.detail.link;[title]img.detail.title;" class="view-icon">View person</div>
                    </div>
                </div> 
            </a>
            {% endfor %}
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const allImages = Array.from(document.querySelectorAll('.random-image-item'));
            
            // Shuffle the array of image elements
            for (let i = allImages.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [allImages[i], allImages[j]] = [allImages[j], allImages[i]];
            }
            
            // Select how many random images to show
            const numToShow = 14; 
            
            // Show the randomly selected images
            for (let i = 0; i < numToShow && i < allImages.length; i++) {
                allImages[i].style.display = ''; // Remove display: none
            }

            // Remove loading animation once displayed images are loaded
            document.querySelectorAll('.image-card img').forEach(img => {
                if (img.complete) {
                    img.classList.add('loaded');
                } else {
                    img.addEventListener('load', function() {
                        this.classList.add('loaded');
                    });
                }
            });
        });
    </script>

    <br/>
    <hr/>

    {# <p>Statistiken zum MEMO Projekt:</p>
    <div id="searchResults"></div>
    {{ macros.dc_stats('searchResults') }} #}



     <style>

        .gallery-container {
            
        }

        .image-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: .5rem;
        }

        .image-card {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }

        .image-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
        }

        .image-card img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }

        .image-card:hover img {
            transform: scale(1.05);
        }

        .image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.7) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
            display: flex;
            align-items: flex-end;
            padding: 1rem;
            color: white;
        }

        .image-card:hover .image-overlay {
            opacity: 1;
        }

        .overlay-content {
            width: 100%;
        }

        .view-icon {
            font-size: 1.2rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .view-icon::before {
            content: '🔍';
            font-size: 1.5rem;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .image-grid {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 1rem;
            }

            .image-card img {
                height: 250px;
            }
        }

    </style>

{% endblock %}