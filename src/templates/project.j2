{% extends "parents/base.j2" %}
{% block content %}
    {# <h1>{{ project.projectTitle }}</h1> #}
    <h1>MEMO</h1>
    {# <h2 class="h3 fw-light">{{ project.projectSubTitle }}</h2> #}
    <h2 class="h3 fw-light">Digitales Memobuch der Stadt Graz</h2>
    <hr/>
    <p>{{ project.projectDesc }}</p>



    <p>Suchbegriff: <b id="searchQueryDisplay"></b></p>
    <p>Suchergebnisse: <b id="resultCount">0</b></p>

    <p>Statistiken zum MEMO Projekt:</p>
    <ul class="list-group" id="searchResults"></ul>

    
    {# <div id="searchSpinner">
        <div id="spinner" class="spinner-border" role="status">
            
        </div>
        
    </div> #}

    <script>
    
        (async () => {

            let statsContainer = document.createElement("div");

            let searchResultUl = document.createElement("ul");
            statsContainer.appendChild(searchResultUl);

            // some pre selections
            let resultUl = document.createElement("ul");
            resultUl.classList.add("list-group");
            statsContainer.appendChild(resultUl);
            //let resultSpinner = document.querySelector("#searchSpinner")
            let resultCountElement = document.createElement("p");
            statsContainer.appendChild(resultCountElement);
            let searchQueryDisplay = document.createElement("p");
            statsContainer.appendChild(searchQueryDisplay);

            let requestUrl = new URL("{{env.GAMS_API_ORIGIN}}/api/v1/integration/gsearch/facets?projects={{ project.projectAbbr }}");

            let resp = await fetch(requestUrl.toString());
            let body = await resp.json();


            //searchQueryDisplay.innerText = `"${searchQuery}"`;
            resultCountElement.innerText = body.result.pagination.totalElements;

            console.log(body);

            // TODO this weird proeprties should be changed in the backend
            // display only dc.subject facets for now

            body.availableFacets["dc.subject"].forEach(facetItem => {
                console.log(facetItem);
                let htmlLi = `
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        ${facetItem.value}
                        <span class="badge bg-primary rounded-pill">${facetItem.count}</span>
                    </li>
                `;
                resultUl.insertAdjacentHTML("beforeend", htmlLi);
            });


            //resultSpinner.remove();

            // append everything to the body
            document.querySelector("main").appendChild(resultUl);

        })();
    
    </script>

{% endblock %}