{% from 'parents/i18n.j2' import enable_i18en_logic with context %}

<!doctype html>
<html lang="de" prefix="og: https://ogp.me/ns# dc: http://purl.org/dc/terms schema_org: https://schema.org/">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# 
      SEO 
    #}
    {% include "includes/seo.j2" %}

    <title>{{context.project.projectAbbr}} project</title>
    <link rel="manifest" href="{{context._root_path}}/static/manifest.json"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="{{context._root_path}}/static/css/project.css" rel="stylesheet">
    {#
     Saxon JS is a XSLT 3.0 processor that can be used in the browser.
    #}
    <script src="{{context._root_path}}/static/js/SaxonJS3-beta-1.rt.js"></script>

    {# Definition of global variables / gams_frog variable #}
    {% include "parents/gams_frog_setup.j2" %}

  </head>
  <body>
    <header class="bg-light">
      <div class="row">
        <div class="col-xl-1">
          <img width="120" src="{{context._root_path}}/static/img/main_logo.jpg">
        </div>
        <div class="col-xl-6">
          <div class="mt-4">
            <h1 data-i18n="header.title" class="h4">Das Digitale Gedenkbuch der Grazer NS-Opfer</h1>
            <small data-i18n="header.description">MEMO ist ein digitales Denkmal, das sich der Dokumentation und Visualisierung der Grazer NS-Opfer widmet.</small>
          </div>
        </div>
      </div>
    </header>
    {% include "includes/nav.j2" %}
    <main class="container-fluid" id="main-container">
    {% block content %}
        {% endblock %}
    </main>
    {% include "includes/footer.j2" %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script type="text/javascript" language="javascript" src="{{context._root_path}}/static/js/project.js"></script>


    <script>
      window.gams_frog.i18n.translate();
    </script>


  </body>
</html>