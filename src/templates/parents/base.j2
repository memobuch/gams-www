<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{context.project.projectAbbr}} project</title>
    <link rel="manifest" href="{{context._root_path}}/static/manifest.json"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="{{context._root_path}}/static/css/project.css" rel="stylesheet">
    {#
     Saxon JS is a XSLT 3.0 processor that can be used in the browser.
    #}
    <script src="{{context._root_path}}/static/js/SaxonJS3-beta-1.rt.js"></script>

    {# Definition of global variables #}
    <script>
      window.pollin = {
        "_root_path": "{{context._root_path}}",
        "_template_name": "{{context._template_name}}",
        "_template_file_name": "{{context._template_file_name}}",
        "env": {
          "DANGEROUS_GAMS3_PRODUCTION_ORIGIN": "{{context.env.DANGEROUS_GAMS3_PRODUCTION_ORIGIN}}",
          "DANGEROUS_GAMS5_PRODUCTION_ORIGIN": "{{context.env.DANGEROUS_GAMS5_PRODUCTION_ORIGIN}}",
          "GAMS_API_ORIGIN": "{{context.env.GAMS_API_ORIGIN}}",
          "IIIF_IMAGE_SERVER_ORIGIN": "{{context.env.IIIF_IMAGE_SERVER_ORIGIN}}",
          "POLLIN_MODE": "{{context.env.POLLIN_MODE}}",
          "PROJECT_ABBR": "{{context.project.projectAbbr}}",
          "UI_TITLE": "{{context.env.UI_TITLE}}",
          "UI_VERSION": "{{context.env.UI_VERSION}}"
        }
      }
    </script>

  </head>
  <body>
    <header class="bg-light">
      <div class="row">
        <div class="col-xl-2">
          <img width="200" src="{{context._root_path}}/static/img/main_logo.png">
        </div>
        <div class="col-xl-6">
          <div class="mt-3 p-2">
            <h1>Das Digitale Memobuch der Stadt Graz</h1>
            <p>Das MEMO Digitale Memobuch ist ein digitales Denkmal, das sich der Dokumentation und Visualisierung der Verfolgung von Opfern des Nationalsozialismus in Graz zwischen 1938 und 1945 widmet.</p>
          </div>
        </div>
      </div>
    </header>
    {% include "includes/nav.j2" %}
    <main class="container-fluid" id="main-container">
    {% block content %}
        {% endblock %}
    </main>
    {% include "includes/footer.j2" %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script type="text/javascript" language="javascript" src="{{context._root_path}}/static/js/project.js"></script>
  </body>
</html>