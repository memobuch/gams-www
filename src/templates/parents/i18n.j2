{# 
 This macro includes a script block with the i18n logic applied to  
 a gams project frontend. Translates all elements with the data-i18n attribute according
 to language (lang url parameter) defined in the related i18n file.  
 @param defaultLanguage: default language to be used for translation

 1. data-i18n attribute on any html element will be translated (based on ids)
 2. query parameter 'lang' (should be ISO code - e.g. 'de', 'en')
 3. additional translation files in i18n folder in static
#}

{% macro enable_i18en_logic(defaultISOLanguage) -%}

<script>
    (async () => {

        const LANG_QUERY_PARAMETER = "lang"

        let defaultLanguage = '{{defaultISOLanguage}}';
        if(defaultLanguage.length == 0){
            defaultLanguage = 'de';
        }

        // use value from url query parameter
        let searchParams = new URLSearchParams(window.location.search);
        const currentLanguage = searchParams.get(LANG_QUERY_PARAMETER) || defaultLanguage;

        let i18nTranslationFileUrl = `/pub/{{context.project.projectAbbr}}/static/i18n/${currentLanguage}.json`;
        
        let response;
        await fetch(i18nTranslationFileUrl)
            .then(resp => {
            if (resp.ok) {
                response = resp;
            } else {
                console.error("Failed to fetch translation file for language:", currentLanguage ," at url: ",i18nTranslationFileUrl)
            }
            }).catch(error => {
            console.error("Failed to fetch translation file for language:", currentLanguage ," at url: ",i18nTranslationFileUrl);
            return;
        });

        if (!response) {
            return;
        }
        
        let data;
        await response.json().then(
            parsed => {
            data = parsed;
        }).catch(error => {
            console.error("Failed to parse translation file for language:", currentLanguage ," at url:"  , i18nTranslationFileUrl);
        });

        if(!data) {
            return;
        }


        document.querySelectorAll('[data-i18n]').forEach(element => {
            const key = element.getAttribute('data-i18n');
            if (data[key]) {
                element.innerHTML = data[key];
            }
            else {
                console.log(`No translation found for key: ${key} in data:`, data);
            }
        });
    })();

</script>

{%- endmacro %}