<script>

  // set active nav link
  (() => {
    let selector = `nav a[data-active-template='${gams_frog._template_name}']`
    let navLink = document.querySelector(selector);

    // Debugging information only if in development using jinja2 conditionals
    {% if "dev" in context.env.GAMS_FROG_MODE %}
      console.debug("Setting active nav a element to selection: ", selector, " Selected element: ", navLink);
    {% endif %}

    if(!navLink){
      return;
    }
    document.querySelector(selector).classList.add("active");
  })();

  // set active language
  (() => {
    const currentLang = new URLSearchParams(window.location.search).get('lang') 
                        || '{{ defaultISOLanguage | default("de") }}';
    
    document.querySelectorAll('.lang-switch').forEach(link => {
      const targetLang = link.dataset.lang;
      
      // build href preserving current path and other params
      const params = new URLSearchParams(window.location.search);
      params.set('lang', targetLang);
      link.href = window.location.pathname + '?' + params.toString();
      
      // mark the active language
      if (targetLang === currentLang) {
        link.classList.add('active', 'fw-bold');
        link.setAttribute('aria-current', 'true');
      }
    });
  })();
</script>

